# Copy to .env (git-ignored) or export these in your shell. Names only - never commit values.
# Databento market-data API key (read by quanttime/utils/config.py)
DATABENTO_KEY=
# SSH password for the "quanttime" user on the compute servers (dashboard sync / deploy scripts)
R630XL_SSH_PASSWORD=
# Password to set for the "quanttime" Linux user in server/setup/ubuntu_server_setup.sh
QUANTTIME_USER_PASSWORD=
# PostgreSQL password (docker-compose and server/setup/*.sh)
POSTGRES_PASSWORD=
# Grafana admin password (docker-compose.monitoring.yml, dashboard monitoring tab)
GRAFANA_ADMIN_PASSWORD=
