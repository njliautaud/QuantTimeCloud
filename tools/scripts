#!/usr/bin/env python3
"""
QuantTime Automated Startup Script
One-click startup for the entire QuantTime system

This script will:
1. Check and setup environment automatically
2. Install missing dependencies
3. Launch the dashboard
4. Provide status updates

Usage:
    python start_quanttime.py
"""

import os
import sys
import subprocess
import time
import webbrowser
from pathlib import Path

def print_status(message, status="INFO"):
    """Print formatted status message"""
    colors = {
        "INFO": "\033[94m",    # Blue
        "SUCCESS": "\033[92m", # Green
        "WARNING": "\033[93m", # Yellow
        "ERROR": "\033[91m",   # Red
        "RESET": "\033[0m"     # Reset
    }
    print(f"{colors.get(status, colors['INFO'])}[{status}] {message}{colors['RESET']}")

def check_python_version():
    """Check Python version compatibility"""
    version = sys.version_info
    if version.major < 3 or (version.major == 3 and version.minor < 11):
        print_status("Python 3.11+ required", "ERROR")
        return False
    print_status(f"Python {version.major}.{version.minor}.{version.micro} ✓", "SUCCESS")
    return True

def setup_environment():
    """Setup virtual environment and install dependencies"""
    project_root = Path(__file__).parent
    venv_path = project_root / ".venv"
    
    # Create virtual environment if it doesn't exist
    if not venv_path.exists():
        print_status("Creating virtual environment...", "INFO")
        try:
            subprocess.run([sys.executable, "-m", "venv", str(venv_path)], check=True)
            print_status("Virtual environment created ✓", "SUCCESS")
        except subprocess.CalledProcessError:
            print_status("Failed to create virtual environment", "ERROR")
            return False
    
    # Get pip command
    if os.name == 'nt':  # Windows
        pip_cmd = str(venv_path / "Scripts" / "pip.exe")
        python_cmd = str(venv_path / "Scripts" / "python.exe")
    else:  # Unix/Linux
        pip_cmd = str(venv_path / "bin" / "pip")
        python_cmd = str(venv_path / "bin" / "python")
    
    # Install QuantTime using setup.py
    print_status("Installing QuantTime...", "INFO")
    try:
        # Upgrade pip
        subprocess.run([pip_cmd, "install", "--upgrade", "pip"], check=True, capture_output=True)
        print_status("Pip upgraded ✓", "SUCCESS")
        
        # Install QuantTime in development mode using setup.py
        subprocess.run([pip_cmd, "install", "-e", str(project_root)], check=True, capture_output=True)
        print_status("QuantTime installed ✓", "SUCCESS")
        
        return python_cmd
    except subprocess.CalledProcessError as e:
        print_status(f"Failed to install QuantTime: {e}", "ERROR")
        return False

def create_directories():
    """Create necessary project directories"""
    directories = ["data", "logs", "cache", "temp", "config", "models", "backtests"]
    project_root = Path(__file__).parent
    
    for directory in directories:
        dir_path = project_root / directory
        dir_path.mkdir(exist_ok=True)
    
    print_status("Project directories created ✓", "SUCCESS")

def test_imports(python_cmd):
    """Test critical imports"""
    print_status("Testing imports...", "INFO")
    
    test_script = """
import sys
try:
    import streamlit
    import pandas
    import numpy
    import ray
    import quanttime
    print("SUCCESS")
except ImportError as e:
    print(f"FAILED: {e}")
    sys.exit(1)
"""
    
    try:
        result = subprocess.run([python_cmd, "-c", test_script], 
                              capture_output=True, text=True, check=True)
        if "SUCCESS" in result.stdout:
            print_status("All imports successful ✓", "SUCCESS")
            return True
        else:
            print_status("Some imports failed", "WARNING")
            return False
    except subprocess.CalledProcessError:
        print_status("Import test failed", "ERROR")
        return False

def launch_dashboard(python_cmd):
    """Launch the Streamlit dashboard"""
    print_status("Launching QuantTime Dashboard...", "INFO")
    print_status("Dashboard will be available at: http://localhost:8501", "INFO")
    print_status("Press Ctrl+C to stop the dashboard", "INFO")
    
    # Open browser after a short delay
    def open_browser():
        time.sleep(3)
        try:
            webbrowser.open("http://localhost:8501")
            print_status("Browser opened automatically ✓", "SUCCESS")
        except:
            print_status("Please open http://localhost:8501 in your browser", "INFO")
    
    # Start browser opener in background
    import threading
    browser_thread = threading.Thread(target=open_browser)
    browser_thread.daemon = True
    browser_thread.start()
    
    # Launch dashboard
    try:
        subprocess.run([python_cmd, "-m", "streamlit", "run", "run.py", "--server.port", "8501"])
    except KeyboardInterrupt:
        print_status("\nDashboard stopped by user", "INFO")
    except Exception as e:
        print_status(f"Failed to launch dashboard: {e}", "ERROR")

def main():
    """Main startup function"""
    print_status("=" * 60, "INFO")
    print_status("QuantTime Automated Startup", "INFO")
    print_status("=" * 60, "INFO")
    
    # Check Python version
    if not check_python_version():
        sys.exit(1)
    
    # Setup environment
    python_cmd = setup_environment()
    if not python_cmd:
        sys.exit(1)
    
    # Create directories
    create_directories()
    
    # Test imports
    if not test_imports(python_cmd):
        print_status("Some dependencies may be missing, but continuing...", "WARNING")
    
    # Launch dashboard
    launch_dashboard(python_cmd)

if __name__ == "__main__":
    main()
