  "sync_settings": {
    "max_file_size_mb": 100,
    "sync_interval_minutes": 5,
    "retry_attempts": 3,
    "chunk_size_mb": 10,
    "parallel_transfers": 4,
    "cross_platform": true,
    "windows_path_separator": "\\",
    "linux_path_separator": "/"
  },
  "large_file_dirs": [
    "data/es_futures",
    "data/processed",
    "models",
    "backtest/results",
    "logs"
  ],
  "sync_patterns": {
    "include": [
      "*.parquet",
      "*.pkl",
      "*.joblib",
      "*.h5",
      "*.csv",
      "*.json",
      "*.log"
    ],
    "exclude": [
      "*.pyc",
      "__pycache__",
      ".git",
      ".venv",
      "node_modules",
      "temp/*",
      "*.tmp"
    ]
  }
}