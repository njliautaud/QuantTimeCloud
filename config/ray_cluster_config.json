  "cluster_settings": {
    "auto_scaling": true,
    "min_workers": 1,
    "max_workers": 10,
    "idle_timeout_minutes": 5,
    "object_store_memory": "2GB",
    "redis_max_memory": "1GB",
    "cross_platform": true,
    "auto_detect_resources": true,
    "git_sync_enabled": true,
    "sftp_sync_enabled": true
  },
  "git_config": {
    "repository_url": "https://github.com/njliautaud/QuantTimeCloud.git",
    "branch": "master",
    "auto_pull_enabled": true,
    "monitor_interval_seconds": 30,
    "github_pat_required": true
  },
  "sync_config": {
    "large_file_threshold_mb": 100,
    "sync_directories": [
      "data/es_futures",
      "data/processed",
      "models",
      "backtests/results",
      "logs"
    ],
    "exclude_patterns": [
      "*.pyc",
      "__pycache__",
      ".git",
      ".venv",
      "node_modules",
      "temp/*"
    ]
  }
}
